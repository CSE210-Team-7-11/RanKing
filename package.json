{
  "name": "ranking",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "npm run db:setup && node --watch --env-file-if-exists=.env src/server/index.ts",
    "db:setup": "node --env-file-if-exists=.env scripts/dev/prepare-database.ts",
    "db:reset": "node --env-file-if-exists=.env scripts/dev/prepare-database.ts --reset",
    "dev:services": "node scripts/dev/run.ts",
    "dev:local": "npm run db:setup && node --env-file-if-exists=.env scripts/dev/run.ts --app",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && npm run typecheck:web && tsc -p tests/fixtures/at-client/tsconfig.json",
    "typecheck:web": "tsc --project web/tsconfig.json",
    "lint": "npm run lint:ts && npm run lint:html && npm run lint:css",
    "lint:ts": "eslint . --max-warnings 0",
    "lint:html": "htmlhint \"web/**/*.html\" \"tests/fixtures/**/*.html\"",
    "lint:css": "stylelint --allow-empty-input \"web/**/*.css\"",
    "build": "npm run typecheck && npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.build.json",
    "build:web": "vite build",
    "check": "npm run lint && npm run typecheck",
    "test": "npm run test:node && npm run test:e2e && npm run test:at:browser",
    "test:node": "npm run test:unit && npm run test:integration",
    "test:unit": "node --test \"tests/unit/**/*.test.ts\"",
    "test:integration": "node --test \"tests/integration/**/*.test.ts\"",
    "test:e2e": "playwright test --project=chromium --pass-with-no-tests",
    "test:e2e:desktop": "playwright test --pass-with-no-tests",
    "test:at:browser": "playwright test -c playwright.at.config.ts --project=chromium",
    "test:at:desktop": "playwright test -c playwright.at.config.ts",
    "test:coverage": "c8 node --test \"tests/unit/**/*.test.ts\" \"tests/integration/**/*.test.ts\""
  },
  "devDependencies": {
    "@atproto/crypto": "0.5.8",
    "@atproto/oauth-client-browser": "0.5.16",
    "@atproto/pds": "0.5.62",
    "@atproto/xrpc-server": "0.13.14",
    "@did-plc/server": "0.0.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/express": "4.17.25",
    "@types/node": "24.19.2",
    "c8": "12.0.0",
    "eslint": "10.14.0",
    "htmlhint": "1.9.2",
    "stylelint": "18.0.0",
    "stylelint-config-standard": "41.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8"
  },
  "c8": {
    "all": true,
    "include": [
      "src/server/**/*.ts"
    ],
    "exclude": [
      "**/*.d.ts"
    ],
    "extension": [
      ".ts"
    ],
    "reporter": [
      "text",
      "html",
      "lcov",
      "json-summary"
    ],
    "reports-dir": "coverage",
    "check-coverage": false
  }
}
